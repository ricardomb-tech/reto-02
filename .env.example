# Hugging Face API token (required). Get one at https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Model used for sentiment classification (optional, this is the default)
HF_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english

# Networking (optional)
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3

# Caching (optional)
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# Cache backend: "memory" (default, no infra needed) or "redis" (shared across replicas)
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Rate limiting, format "<count>/<period>" e.g. "10/minute" (optional)
RATE_LIMIT=10/minute

# Rate limiting for /sentiment/batch, and max texts accepted per batch request (optional)
BATCH_RATE_LIMIT=5/minute
BATCH_MAX_SIZE=50

# Confidence below this returns NEUTRAL instead of forcing POSITIVE/NEGATIVE (optional)
NEUTRAL_CONFIDENCE_THRESHOLD=0.6

# Circuit breaker: consecutive upstream failures before failing fast, and cooldown in seconds (optional)
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# Reject request bodies larger than this many bytes (optional)
MAX_REQUEST_BODY_BYTES=262144

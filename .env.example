# Hugging Face API token (required). Get one at https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Model used for sentiment classification (optional, this is the default)
HF_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english

# Networking (optional)
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3

# Caching (optional)
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# Rate limiting, format "<count>/<period>" e.g. "10/minute" (optional)
RATE_LIMIT=10/minute
